{
  "expo": {
    "newArchEnabled": true,
    "name": "Crypto-Tracker",
    "slug": "crypto-tracker",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "plugins": ["expo-notifications"],
    "notification": {
      "icon": "./assets/adaptive-icon.png",
      "color": "#D4AF37",
      "iosDisplayInForeground": true,
      "androidMode": "default",
      "androidChannelId": "price-alerts"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.crypto.artcode",
      "buildNumber": "1",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.crypto.artcode",
      "versionCode": 1,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "WAKE_LOCK",
        "POST_NOTIFICATIONS"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "lang": "ru"
    },
    "extra": {
      "eas": {
        "projectId": "f556dbb0-4097-471a-8189-9f4c6d13fefd"
      }
    }
  }
}
