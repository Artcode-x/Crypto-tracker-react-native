{
  "expo": {
    "name": "Crypto-Tracker",
    "slug": "crypto-tracker",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#D4AF37",
          "iosDisplayInForeground": true
        }
      ],
      "expo-background-fetch"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.crypto.artcode",
      "buildNumber": "1",
      "infoPlist": {
        "UIBackgroundModes": ["fetch", "remote-notification"],
        "NSUserNotificationsUsageDescription": "This app uses notifications to send price alerts.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      },
      "requireFullScreen": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.crypto.artcode",
      "versionCode": 1,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "WAKE_LOCK",
        "POST_NOTIFICATIONS",
        "FOREGROUND_SERVICE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK"
      ],
      "useNextNotificationsApi": true,
      "allowBackup": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "lang": "ru"
    },
    "extra": {
      "eas": {
        "projectId": "8a1401d1-7ebd-4be4-b520-7b18ad4517ba"
      }
    },
    "owner": "art-codes-organization"
  }
}
